@using System.Globalization
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Localization
@using Logistico.SharedKernel
@using Logistico.Web.Data
@using Logistico.Web.Infrastructure
@inject IStringLocalizer<ServerText> T
@inject ApplicationDbContext Db
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name" dir="@(Rtl ? "rtl" : "ltr")">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ecebea" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content="@T["SeoDescription"]" />
    <meta name="application-name" content="Logistico" />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href="@CanonicalUrl" />
    <meta property="og:title" content="@T["SeoTitle"]" />
    <meta property="og:description" content="@T["SeoDescription"]" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@CanonicalUrl" />
    <meta property="og:locale" content="@(Rtl ? "ar_IQ" : "en_US")" />
    <meta property="og:locale:alternate" content="@(Rtl ? "en_US" : "ar_IQ")" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@T["SeoTitle"]" />
    <meta name="twitter:description" content="@T["SeoDescription"]" />
    <base href="/" />
    <title>@T["SeoTitle"]</title>
    @((MarkupString)StructuredData)
    <ResourcePreloader />
    <link rel="preload" href="@Assets["lib/almarai/almarai-arabic-400.woff2"]" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="@Assets["lib/almarai/almarai.css"]" />
    @* Arabic pages use Blueprint's mirrored build (generated by scripts/vendor-ui-assets.sh with RTLCSS). *@
    <link rel="stylesheet" href="@Assets[Rtl ? "lib/blueprint/blueprint.rtl.css" : "lib/blueprint/blueprint.css"]" />
    <link rel="stylesheet" href="@Assets[Rtl ? "lib/blueprint/blueprint-select.rtl.css" : "lib/blueprint/blueprint-select.css"]" />
    <link rel="stylesheet" href="@Assets["lib/blueprint/blueprint-icons.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    @if (IsAccountPage)
    {
        <link rel="stylesheet" href="@Assets["account.css"]" />
    }
    @BrandStyle
    <ImportMap nonce="@HttpContext.CspNonce()" />
    <link rel="icon" type="image/png" href="favicon.png" />
    @* Installable on a phone's home screen (the courier app, the hub station). *@
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="apple-touch-icon" href="icons/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Logistico" />
    <script src="@Assets["js/lx.js"]"></script>
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <script nonce="@HttpContext.CspNonce()">lx.applyTheme();</script>
    @if (!IsAccountPage)
    {
        <div class="lx-boot-splash" aria-hidden="true">
            <div class="lx-boot-hub">
                <span class="lx-boot-ring"></span>
                <span class="lx-logo lx-logo-large lx-boot-logo"></span>
            </div>
            <div class="lx-boot-route"><span class="lx-boot-parcel"></span></div>
            <span class="lx-boot-word">لوجستيكو</span>
        </div>
        <div id="lx-boot-failed" class="lx-boot-splash" style="display:none">
            <p>لم يكتمل فتح لوجستيكو. أعد تحميل الصفحة.</p>
            <p>Logistico did not finish opening. Reload the page.</p>
            <a href=".">إعادة التحميل · Reload</a>
        </div>
        <script nonce="@HttpContext.CspNonce()">
            setTimeout(function () {
                if (document.querySelector(".lx-app, .lx-public, .lx-boot, .lx-account")) return;
                var splash = document.querySelector(".lx-boot-splash");
                if (splash) splash.hidden = true;
                var failed = document.getElementById("lx-boot-failed");
                if (failed) failed.style.display = "flex";
            }, 45000);
        </script>
    }
    <Routes @rendermode="PageRenderMode" />
    @if (!IsAccountPage)
    {
        <script src="@Assets["_framework/blazor.web.js"]"></script>
    }
    @if (IsAccountPage)
    {
        <script src="@Assets["Components/Account/Shared/PasskeySubmit.razor.js"]" type="module"></script>
    }
</body>

</html>

@code {
    // The app runs entirely in the browser (WebAssembly) and talks to the REST API.
    // Prerendering is off so components never execute on the server.
    private static readonly IComponentRenderMode ClientOnly = new InteractiveWebAssemblyRenderMode(prerender: false);

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private static bool Rtl => CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft;

    private string? brandColor;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            brandColor = await Db.CompanyProfiles
                .Where(p => p.TenantId == Tenants.Default)
                .Select(p => p.BrandColor)
                .FirstOrDefaultAsync();
        }
        catch
        {
            // Branding is cosmetic; a database still being set up on first run just uses the default emerald.
        }
    }

    // The company's chosen brand colour overrides the emerald tokens in both light and dark; emitted after app.css.
    // The value is a validated #RRGGBB, so it is safe to place inside the stylesheet.
    private MarkupString BrandStyle
    {
        get
        {
            var c = brandColor;
            if (c is not { Length: 7 } || !System.Text.RegularExpressions.Regex.IsMatch(c, "^#[0-9a-fA-F]{6}$"))
            {
                return default;
            }

            var css = $":root,body.bp6-dark{{--lx-primary:{c};"
                + $"--lx-primary-soft:color-mix(in srgb,{c} 12%,var(--lx-surface));"
                + $"--lx-primary-text:color-mix(in srgb,{c} 68%,var(--lx-text-strong));"
                + $"--lx-primary-border:color-mix(in srgb,{c} 32%,var(--lx-border));"
                + $"--lx-selected:{c};--lx-selected-hover:color-mix(in srgb,{c} 84%,#000);--lx-selected-active:color-mix(in srgb,{c} 70%,#000);"
                + $"--bp-intent-primary-rest:{c};--bp-intent-primary-hover:color-mix(in srgb,{c} 85%,#000);--bp-intent-primary-active:color-mix(in srgb,{c} 72%,#000);"
                + "--lx-link:var(--lx-primary-text);}";
            return new MarkupString($"<style nonce=\"{HttpContext.CspNonce()}\">{css}</style>");
        }
    }

    // Account pages (login, register, 2FA…) opt out and render statically on the server.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? ClientOnly : null;

    private bool IsAccountPage => HttpContext.Request.Path.StartsWithSegments("/Account");

    // Crawlers and link previews read this shell; the WebAssembly UI replaces the title per page after it loads.
    private string CanonicalUrl =>
        $"{HttpContext.Request.Scheme}://{HttpContext.Request.Host}{HttpContext.Request.PathBase}{HttpContext.Request.Path}";

    // Written as raw markup so the script type stays "application/ld+json" (Razor would encode the plus sign).
    private string StructuredData =>
        $"<script type=\"application/ld+json\" nonce=\"{HttpContext.CspNonce()}\">{JsonLd}</script>";

    private string JsonLd => JsonSerializer.Serialize(new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "SoftwareApplication",
        ["name"] = "Logistico",
        ["applicationCategory"] = "BusinessApplication",
        ["operatingSystem"] = "Web",
        ["description"] = T["SeoDescription"].Value,
        ["inLanguage"] = new[] { "ar", "en" },
        ["codeRepository"] = "https://github.com/Haix02/logistico-software",
        ["license"] = "https://www.apache.org/licenses/LICENSE-2.0.html",
        ["offers"] = new Dictionary<string, string>
        {
            ["@type"] = "Offer",
            ["price"] = "0",
            ["priceCurrency"] = "USD",
        },
    });
}
