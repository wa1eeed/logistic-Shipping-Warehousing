@* A calm summary of the period: a plain-language sentence beside three headline figures that count up on load.
   Built from data the dashboard already loaded — no extra request, no business logic. *@
@inject IJSRuntime JS

<section class="lx-brief lx-card lx-rise" aria-label="@L["Dashboard_Briefing_Lead"]">
    <div class="lx-brief-copy">
        <span class="lx-brief-lead"><span class="lx-brief-pulse" aria-hidden="true"></span> @L["Dashboard_Briefing_Lead"]</span>
        <p class="lx-brief-text">@Sentence</p>
        @if (AttentionCount > 0)
        {
            <a class="lx-brief-flag" href="automation">
                <Icon Name="warning-sign" />
                <span>@L.Count("Dashboard_Briefing_Attention", AttentionCount)</span>
                <Icon Name="@Bidi.ChevronForward" />
            </a>
        }
    </div>
    <div class="lx-brief-stats">
        <div class="lx-brief-stat">
            <span class="lx-brief-n" @ref="bookedRef">@Fmt.Number((int)Overview.Booked.Value)</span>
            <span class="lx-brief-l">@L["Kpi_Booked"]</span>
            <MetricDelta Change="Overview.Booked.ChangePercent" Compact="true" />
        </div>
        <div class="lx-brief-stat">
            <span class="lx-brief-n" @ref="rateRef">@Fmt.Percent(Overview.SuccessRate.Value)</span>
            <span class="lx-brief-l">@L["Kpi_SuccessRate"]</span>
            <MetricDelta Change="Overview.SuccessRate.ChangePoints" ChangeInPoints="true" Compact="true" />
        </div>
        <div class="lx-brief-stat lx-brief-stat-gold">
            <span class="lx-brief-n">@Fmt.Compact(Overview.CodCollectedIqd.Value, Fmt.CompanyCurrency)</span>
            <span class="lx-brief-l">@L["Kpi_CodCollectedPeriod"]</span>
            <MetricDelta Change="Overview.CodCollectedIqd.ChangePercent" Compact="true" />
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public AnalyticsOverview Overview { get; set; } = default!;
    [Parameter, EditorRequired] public int Days { get; set; }

    /// <summary>How many things on the dashboard currently need a human to look at them.</summary>
    [Parameter] public int AttentionCount { get; set; }

    private ElementReference bookedRef;
    private ElementReference rateRef;

    private string Sentence => string.Format(
        CultureInfo.CurrentCulture,
        L["Dashboard_Briefing"],
        PeriodPhrase,
        L.Count("OrdersN", (int)Overview.Booked.Value),
        Fmt.Number((int)Overview.Delivered.Value),
        Fmt.Percent(Overview.SuccessRate.Value));

    private string PeriodPhrase => Days == 1
        ? L["Period_Today"].Value
        : string.Format(CultureInfo.CurrentCulture, L["Dashboard_PeriodLast"], Days switch
        {
            7 => L["Period_7"].Value,
            30 => L["Period_30"].Value,
            90 => L["Period_90"].Value,
            _ => L.Count("DaysN", Days),
        });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var rate = Overview.SuccessRate.Value;
            var rateDecimals = rate == Math.Round(rate) ? 0 : 1;
            await JS.InvokeVoidAsync("lx.countUp", bookedRef, (double)Overview.Booked.Value, 0, "");
            await JS.InvokeVoidAsync("lx.countUp", rateRef, (double)rate, rateDecimals, "%");
        }
        catch (JSException)
        {
            // The figures are already rendered; the count-up is a nicety, not required.
        }
    }
}
